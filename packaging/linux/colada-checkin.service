[Unit]
Description=colada365 Check-in server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=colada-checkin
Group=colada-checkin
Environment=CHECKIN_DATA_DIR=/var/lib/colada-checkin
EnvironmentFile=-/etc/default/colada-checkin
ExecStart=/opt/colada-checkin/colada-checkin
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/colada-checkin

[Install]
WantedBy=multi-user.target
